{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ingress-workspace",
  "main": "../src/worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "6b149553c5075c79bbc132c481f387fe",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "WorkspaceAgent",
      "image": "registry.cloudflare.com/6b149553c5075c79bbc132c481f387fe/agentbox-agentboxcontainer@sha256:f97de164cd51f6a825ef6ec7c5b5c883c4b900f0409f46675bb372e806119da8",
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceAgent" }]
  },
  "services": [
    { "binding": "GATE", "service": "ingress-workspace", "entrypoint": "CommitGate" }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceAgent"] }],
  "workers_dev": true,
  "preview_urls": true
}