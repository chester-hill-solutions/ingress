{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ingress-workspace",
  "main": "../src/worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "6b149553c5075c79bbc132c481f387fe",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "WorkspaceAgent",
      "image": "registry.cloudflare.com/6b149553c5075c79bbc132c481f387fe/agentbox-agentboxcontainer@sha256:f97de164cd51f6a825ef6ec7c5b5c883c4b900f0409f46675bb372e806119da8",
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceAgent" }]
  },
  "services": [
    { "binding": "GATE", "service": "ingress-workspace", "entrypoint": "CommitGate" }
  ],
  // WORKSPACE_TOKEN is a secret, not a var, and is deliberately absent here.
  //
  // Every `/w/:workspace` route requires it as `x-ingress-workspace-token`. The router
  // fails CLOSED when it is missing: workspace routes answer 503
  // `workspace_token_not_configured` rather than serving unauthenticated callers. So a
  // fresh deploy is visibly broken until the secret is set, which is the correct
  // direction to fail.
  //
  // It is set once per account, not per deploy, and survives redeployment:
  //
  //   cf workers secrets update WORKSPACE_TOKEN --worker ingress-workspace --text "$T"
  //
  // It is written to no file and read by no log. Do not add it to `vars`.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceAgent"] }],
  "workers_dev": true,
  "preview_urls": true
}