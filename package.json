{
  "name": "agent-collaboration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ingress: snapshot-isolated workspaces where concurrent agents never share bytes",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000",
    "demo": "node scripts/probe.mjs",
    "probe:real": "node scripts/probe.mjs --real",
    "check": "node scripts/check.mjs",
    "checkout:prototype": "node scripts/checkout-prototype.mjs",
    "checkout:evaluate": "node scripts/checkout-prototype.mjs --evaluate",
    "checkout:graphify": "node scripts/checkout/graphify-probe.mjs",
    "checkout:lab": "node scripts/checkout/lab-repo.mjs",
    "e2e:commit": "node scripts/commit-e2e.mjs",
    "e2e:lease": "node scripts/lease-e2e.mjs",
    "e2e:seed": "node scripts/seed-e2e.mjs",
    "e2e:bounds": "node scripts/start-bounds-e2e.mjs",
    "e2e:swarm": "node scripts/swarm-e2e.mjs",
    "e2e:concurrency": "node scripts/concurrency-e2e.mjs",
    "e2e:content": "node scripts/content-e2e.mjs",
    "trial": "node scripts/trial.mjs",
    "sandbox:test": "node scripts/sandbox-build-e2e.mjs",
    "squad:real": "node scripts/squad.mjs --real",
    "play": "node scripts/play-game.mjs",
    "benchmark:real": "node scripts/benchmark.mjs --real",
    "missions:plan": "node scripts/mission-benchmark.mjs --plan",
    "missions:real": "node scripts/mission-benchmark.mjs --real",
    "missions:review": "node scripts/blind-review.mjs",
    "checkout:qualify": "node scripts/checkout/qualify-lab.mjs",
    "checkout:compare": "node scripts/checkout/compare-replays.mjs",
    "checkout:agents": "node scripts/checkout/native-flight.mjs",
    "missions:recovery": "node scripts/mission-recovery.mjs",
    "missions:recovery:model": "node scripts/mission-recovery.mjs --participants=model",
    "missions:view": "node scripts/mission-view.mjs",
    "missions:trace": "node scripts/mission-trace.mjs",
    "missions:retain": "node scripts/mission-retain.mjs",
    "missions:regrade": "node scripts/mission-regrade.mjs",
    "missions:summary": "node scripts/mission-summary.mjs"
  },
